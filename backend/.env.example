# Server Configuration
PORT=8000
ENV=development
SERVICE_NAME=nutrimind-backend
SERVICE_VERSION=1.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nutrimind
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_APP_EXPIRY_DAYS=30
JWT_REFRESH_EXPIRY_DAYS=90

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# Web Client ID — used to validate Android tokens (aud = webClientId)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# iOS Client ID — used to validate iOS tokens (aud = iosClientId); leave blank if iOS not needed
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=30
LOG_MAX_AGE_DAYS=90
LOG_COMPRESS=true

# OpenAI Configuration (AI Meal Analysis & AI Coach)
OPENAI_API_KEY=your-openai-api-key
OPENAI_VISION_MODEL=gpt-4o

# Firebase / FCM Configuration (Push Notifications)
# Leave FIREBASE_PROJECT_ID empty to disable FCM (falls back to noop sender)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the full JSON content of your service account key here (single line).
# If empty, Application Default Credentials (ADC) will be used.
FIREBASE_CREDENTIALS_JSON=

# SMTP / Email Configuration (Welcome emails, OTP, password reset)
# Leave SMTP_USERNAME empty to disable outgoing email (falls back to noop sender)
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM defaults to SMTP_USERNAME when left empty
SMTP_FROM=your-email@gmail.com
