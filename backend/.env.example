# Server Configuration
PORT=8000
ENV=development
SERVICE_NAME=nutrimind-backend
SERVICE_VERSION=1.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nutrimind
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_APP_EXPIRY_DAYS=30

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# Web Client ID — used to validate Android tokens (aud = webClientId)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# iOS Client ID — used to validate iOS tokens (aud = iosClientId); leave blank if iOS not needed
GOOGLE_CLIENT_ID_IOS=your-ios-client-id.apps.googleusercontent.com

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cookie Configuration
COOKIE_NAME=app_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_PATH=/

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=30
LOG_MAX_AGE_DAYS=90
LOG_COMPRESS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MIN=60
