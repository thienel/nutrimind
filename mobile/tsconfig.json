{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@services/*": ["./src/services/*"],
      "@database/*": ["./src/database/*"],
      "@utils/*": ["./src/utils/*"],
      "@prompts/*": ["./src/prompts/*"],
      "@t/*": ["./src/types/*"],
      "@app/*": ["./src/app/*"]
    }
  }
}
