# ===========================================================================
# REACT NATIVE (JavaScript / Node.js)
# ===========================================================================

# Dependency directories
node_modules/
jspm_packages/

# Build and temporary outputs
.expo/
.metro/
.bundle/
dist/
build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Keystore / Security files (except default debug)
*.keystore
*.jks
*.p12
*.pfx
*.pem
!android/app/debug.keystore

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microsoft Clarity or other frontend tracking cache
.clarity/

# ===========================================================================
# ANDROID (React Native Native Side)
# ===========================================================================
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/captures/
*.apk
*.aar
*.jsbundle

# Android Studio / IntelliJ project files
.idea/
*.iml
*.ipr
*.iws
.navigation/

# ===========================================================================
# IOS (React Native Native Side)
# ===========================================================================
# Xcode user settings and build artifacts
ios/build/
ios/DerivedData/
ios/Pods/
ios/.xcode.env.local
ios/**/*.xcuserdatad
ios/**/*.xcworkspace/xcuserdata/

# Objective-C/Swift specific configuration
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# CocoaPods backup and temporary files
ios/Podfile.lock

# ===========================================================================
# GOLANG (Backend / Microservices / CLI)
# ===========================================================================
# Binaries and templates
bin/

# Tools-specific binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test related files
*.test
*.out
c.out

# Go coverage and profiling data
*.prof

# Go workspace file
go.work
go.work.sum

# Vendor directory (Optional: uncomment if you prefer not to commit vendored dependencies)
# vendor/

# ===========================================================================
# ENVIRONMENT VARIABLES & CREDENTIALS (CRITICAL SECURITY)
# ===========================================================================
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
config.json
secrets.yaml

# Firebase configuration (contains API keys — never commit)
mobile/google-services.json
mobile/GoogleService-Info.plist

# ===========================================================================
# OPERATING SYSTEMS & EDITORS
# ===========================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

